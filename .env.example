# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# Your own Telegram user id. Leave empty, start the bot and send it /start: it replies with your id.
# Comma-separate to allow more than one approver.
ADMIN_IDS=111111111
# Where the SQLite database lives
DB_PATH=data/agent.db
# Where /backup writes database copies before sending them to you
BACKUP_DIR=data/backups
